# Copy to .env. Local values for `docker compose up -d db`; never real credentials.
DATABASE_URL=postgresql://poultry:poultry@localhost:5432/poultry
# Integration tests (*.int.test.ts) run here; the database is created and reset by the test harness.
TEST_DATABASE_URL=postgresql://poultry:poultry@localhost:5432/poultry_test
# Auth (ADR-005). APP_ORIGIN is checked by CSRF and is Better Auth's base URL.
APP_ORIGIN=http://localhost:3000
# Signs the session cookie. Any long random string locally: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-replace-me-with-32-random-bytes
