// Conventions (SPEC §6, ADR-006): UUIDv7 ids generated on the client (the DB default is only a fallback
// for server-created rows), timestamptz everywhere, and every farm-data table carries organizationId.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Owner: farm-registry
model Organization {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  createdAt     DateTime      @default(now()) @db.Timestamptz
  memberships   Membership[]
  legalEntities LegalEntity[]
  invitations   Invitation[]
  farms         Farm[]
}

// Owner: farm-registry. SPEC F2. Created offline, so the id comes from the device (ADR-003).
model Farm {
  id             String       @id @db.Uuid
  organizationId String       @db.Uuid
  name           String
  region         String
  province       String
  commune        String
  latitude       Float?
  longitude      Float?
  onssaNumber    String? // ONSSA authorization
  onssaExpiresOn DateTime?    @db.Date
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  houses         House[]

  @@index([organizationId])
}

// Owner: farm-registry. SPEC F3.
model House {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid
  farmId         String    @db.Uuid
  name           String
  areaM2         Int
  capacity       Int // birds
  type           HouseType
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz
  farm           Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([farmId])
}

enum HouseType {
  open
  closed
}

// Owner: farm-registry. SPEC F1: the form sets the accounting profile (derived in code, not stored).
model LegalEntity {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  form           LegalForm
  createdAt      DateTime     @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum LegalForm {
  individual
  indivision
  company
  cooperative
  association
  gie
}

// Owner: identity. User, Session, Account and Verification follow Better Auth's schema (ADR-005);
// ids come from the uuidv7() default (Better Auth runs with generateId: false).
model User {
  id                  String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phoneNumber         String?      @unique // E.164 +2126… / +2127…, the login identifier
  phoneNumberVerified Boolean?     @default(false)
  name                String // Better Auth requires it; set to the phone number until onboarding
  email               String       @unique // Better Auth requires it; placeholder <digits>@phone.invalid
  emailVerified       Boolean      @default(false)
  image               String?
  locale              Locale       @default(ar)
  createdAt           DateTime     @default(now()) @db.Timestamptz
  updatedAt           DateTime     @updatedAt @db.Timestamptz
  memberships         Membership[]
  sessions            Session[]
  accounts            Account[]
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Unused by phone login; Better Auth's adapter expects the model.
model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz
  refreshTokenExpiresAt DateTime? @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time codes: identifier = phone number, value = "<code>:<failed attempts>" (Better Auth stores it unhashed).
model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([identifier])
}

// Owner: src/lib/security/rate-limit.ts. One row per counted request (sliding window); old rows are pruned on use.
model RateLimitHit {
  id  BigInt   @id @default(autoincrement())
  key String // "<policy>:<dimension>:<window s>:<value>", phone values hashed
  at  DateTime @default(now()) @db.Timestamptz

  @@index([key, at])
}

enum Locale {
  ar
  fr
}

// Owner: identity
model Membership {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           MemberRole
  createdAt      DateTime     @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// Owner: identity. poultry-auth §1: managers and workers get access only through a pending, unexpired invitation
// for their number. Accepted (and deleted) at their next login; one pending invitation per number per organisation.
model Invitation {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @db.Uuid
  phoneNumber    String // E.164, through PhoneNumber
  role           MemberRole
  invitedById    String       @db.Uuid
  expiresAt      DateTime     @db.Timestamptz
  createdAt      DateTime     @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phoneNumber])
  @@index([phoneNumber])
}

enum MemberRole {
  owner
  manager
  worker
}

// Owner: src/lib/sync/server.ts (ADR-003). One row per pushed mutation id: a replay returns the stored result.
// No FK to Organization, like AuditEvent: organisation deletion purges it explicitly (ADR-007).
model Mutation {
  id             String   @id @db.Uuid // generated on the device
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  type           String
  result         Json // { status: "applied" } | { status: "rejected", messageKey }
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([organizationId])
}

// Owner: src/lib/sync/server.ts. The per-organisation version counter; its row lock orders changes by commit.
model SyncVersion {
  organizationId String @id @db.Uuid
  version        BigInt @default(0)
}

// Owner: src/lib/sync/server.ts. What pull returns: every change to a synced record, in version order.
// data = the record as its module serializes it; null = deleted (tombstone).
model Change {
  organizationId String @db.Uuid
  version        BigInt
  entity         String
  entityId       String @db.Uuid
  data           Json?

  @@id([organizationId, version])
}

// Owner: reference-data (SPEC R1–R4). Global, not per organisation: read-only for farms, seeded from
// prisma/seed/reference/*.json, cached offline through GET /api/reference.
model Strain {
  id     String          @id // "ross-308"
  name   String
  curves StandardCurve[]
}

// One published performance-objectives table (R1). Each value keeps its source and version (OQ5).
model StandardCurve {
  id       String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  strainId String
  source   String // document title + publisher
  version  String // e.g. "2022"
  points   StandardPoint[]
  strain   Strain          @relation(fields: [strainId], references: [id], onDelete: Cascade)

  @@unique([strainId, version])
}

model StandardPoint {
  curveId             String        @db.Uuid
  day                 Int // age in days, as-hatched
  bodyWeightGrams     Int
  cumulativeFeedGrams Int
  curve               StandardCurve @relation(fields: [curveId], references: [id], onDelete: Cascade)

  @@id([curveId, day])
}

enum ProductKind {
  feed
  vaccine
  medicine
}

// R3. Withdrawal days come from the product, never from code (poultry-ddd §3.7); null = not known yet.
model Product {
  id             String      @id // "feed-starter"
  kind           ProductKind
  nameFr         String
  nameAr         String
  withdrawalDays Int?
}

// R2. The global template is read-only; farms copy it into VaccinationProtocol and edit the copy.
model ProtocolTemplate {
  id            String  @id // "broiler-default"
  nameFr        String
  nameAr        String
  reviewedByVet Boolean @default(false) // OQ4: false until a vet signs it off
  items         Json // [{ dayOfAge, productId, method }]
}

// Owner: reference-data. An organisation's own, editable copy of a protocol (written offline, ADR-003).
model VaccinationProtocol {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  templateId     String?
  name           String
  items          Json // same shape as ProtocolTemplate.items
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@index([organizationId])
}

// Owner: notifications (SPEC N1–N3). One row per recipient: their inbox entry, and the outbox for web push, written in
// the caller's transaction and pushed after commit (poultry-ddd §4).
model Notification {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  templateKey    String // messages: Notifications.templates.<key>
  params         Json
  urgent         Boolean   @default(false)
  deliverAfter   DateTime  @db.Timestamptz // end of the recipient's quiet hours when held (N2)
  pushedAt       DateTime? @db.Timestamptz // claimed by the dispatcher
  readAt         DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz

  @@index([userId, createdAt])
  @@index([pushedAt, deliverAfter])
}

// Owner: notifications. One per browser that accepted push (N1).
model PushSubscription {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([userId])
}

// Owner: notifications. N2: quiet hours per user, in farm time (Africa/Casablanca), "HH:MM".
model NotificationPreference {
  userId     String @id @db.Uuid
  quietStart String @default("22:00")
  quietEnd   String @default("06:00")
}

// Owner: inventory (SPEC S1–S3). All written offline: ids come from the device (ADR-003).
model Supplier {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  name           String
  phone          String?
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([organizationId])
}

// S1: one per farm and product (and lot, for vaccines and medicines).
model StockItem {
  id             String    @id @db.Uuid
  organizationId String    @db.Uuid
  farmId         String    @db.Uuid
  productId      String? // reference-data catalogue, when the item is one of its products
  kind           String // feed | vaccine | medicine | litter | gas | other
  name           String
  unit           String // kg (stored in grams) | dose | ml | unit
  lot            String?
  expiresOn      DateTime? @db.Date
  createdAt      DateTime  @default(now()) @db.Timestamptz

  @@index([organizationId, farmId])
}

// S3: the ledger. Stock on hand = sum of quantity; rows are never edited.
model StockMovement {
  id             String   @id @db.Uuid
  organizationId String   @db.Uuid
  farmId         String   @db.Uuid
  stockItemId    String   @db.Uuid
  kind           String // purchase | consumption | adjustment
  quantity       Int // base units (grams for kg), signed: + in, − out
  day            DateTime @db.Date // farm day
  reason         String? // required for an adjustment
  purchaseId     String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([organizationId, stockItemId])
}

// S2: what was bought and paid; amount − paid is supplier credit.
model Purchase {
  id                String    @id @db.Uuid
  organizationId    String    @db.Uuid
  farmId            String    @db.Uuid
  supplierId        String    @db.Uuid
  stockItemId       String    @db.Uuid
  day               DateTime  @db.Date
  quantity          Int
  unitPriceCentimes BigInt // per displayed unit (per kg for feed)
  amountCentimes    BigInt
  paidCentimes      BigInt
  dueOn             DateTime? @db.Date
  createdAt         DateTime  @default(now()) @db.Timestamptz

  @@index([organizationId, supplierId])
}

// Cross-cutting (ADR-006): append-only, written in the same transaction as the change. Never updated or deleted.
// No FK to Organization so the log outlives what it describes; organisation deletion purges it explicitly (ADR-007).
model AuditEvent {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId   String    @db.Uuid
  userId           String?   @db.Uuid
  entity           String
  entityId         String    @db.Uuid
  action           String
  before           Json?
  after            Json?
  mutationId       String?   @db.Uuid
  deviceCreatedAt  DateTime? @db.Timestamptz
  serverReceivedAt DateTime  @default(now()) @db.Timestamptz

  @@index([organizationId, entity, entityId])
}
