# Copy to .env. Local values for `docker compose up -d db`; never real credentials.
DATABASE_URL=postgresql://poultry:poultry@localhost:5432/poultry
# Connection pool per server process (src/lib/db.ts). Keep max × processes under Postgres' max_connections (100).
# DATABASE_POOL_MAX: default 10 (pg's own default). DATABASE_CONNECTION_TIMEOUT_MS: how long a query waits for a free
# connection (or a new one) before failing; default 10000. Before this setting, pg waited forever (0 is not accepted).
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# Integration tests (*.int.test.ts) run here; the database is created and reset by the test harness.
TEST_DATABASE_URL=postgresql://poultry:poultry@localhost:5432/poultry_test
# Uploaded files, all of an organisation's together (SPEC-m2-compliance D4). Default 2 GB; decided default, to review.
# ORG_STORAGE_MAX_BYTES=2147483648
# Auth (ADR-005). APP_ORIGIN is checked by CSRF and is Better Auth's base URL.
APP_ORIGIN=http://localhost:3000
# Signs the session cookie. Any long random string locally: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-replace-me-with-32-random-bytes
# Captcha before every login code request (poultry-auth references/captcha.md). Signs the challenges: any long random
# string locally (openssl rand -base64 32); the server refuses to start in production without it.
CAPTCHA_HMAC_KEY=dev-only-replace-me-with-32-random-bytes
# Difficulty: the phone tries up to this many PBKDF2 keys (5 000 iterations each). Default 50 (~1 s on a low-end phone).
# CAPTCHA_MAX_NUMBER=50
# CAPTCHA_DISABLED=true skips the check outside production only (unit tests); production refuses to start with it.
# Web push (SPEC N1). Generate a pair: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Without them the inbox works and push stays off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid
# Bearer token for POST /api/push/dispatch, called every minute by the host's scheduler (T26). Unset: route is 404.
CRON_SECRET=
