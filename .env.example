# Copy to .env. Local values for `docker compose up -d db`; never real credentials.
# Every variable the code reads is listed here. With NODE_ENV=production the server refuses to start on a missing,
# placeholder or unsafe value (src/lib/env.ts). NODE_ENV, NEXT_RUNTIME and CI are set by the tools, not here.

# --- Database ---
# Postgres connection string (src/lib/db.ts, prisma.config.ts, prisma/seed.ts). Required in production.
DATABASE_URL=postgresql://poultry:poultry@localhost:5432/poultry
# For `prisma migrate deploy` only (prisma.config.ts), when DATABASE_URL is a transaction pooler such as Supabase's
# port 6543: a session or direct connection. Unset: DATABASE_URL. Leave it out of a local .env.
# DIRECT_URL=
# The database's CA certificate (PEM), to verify its TLS certificate (src/lib/db.ts): Supabase signs with its own CA.
# Set, it replaces any ssl* parameter of DATABASE_URL. docs/deploy-vercel-supabase.md.
# DATABASE_CA_CERT=
# Connection pool per server process (src/lib/db.ts). Keep max × processes under Postgres' max_connections (100).
# DATABASE_POOL_MAX: default 10 (pg's own default). DATABASE_CONNECTION_TIMEOUT_MS: how long a query waits for a free
# connection (or a new one) before failing; default 10000. Before this setting, pg waited forever (0 is not accepted).
# On Vercel every function instance has its own pool: keep it at 3 there (docs/deploy-vercel-supabase.md).
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# Uploaded files, all of an organisation's together (SPEC-m2-compliance D4). Default 2 GB; decided default, to review.
# ORG_STORAGE_MAX_BYTES=2147483648

# --- Auth (ADR-005, ADR-015) ---
# The site's exact origin, checked by CSRF and Better Auth's base URL. Production: https:// scheme and host, no path.
APP_ORIGIN=http://localhost:3000
# Signs the session cookie and keys the stored invite and reset codes' HMACs (rotating it kills pending codes). Any long
# random string locally: openssl rand -base64 32. Production: 32+ characters, not this.
BETTER_AUTH_SECRET=dev-only-replace-me-with-32-random-bytes
# Captcha on every sign-up and after 3 failed sign-ins (poultry-auth references/captcha.md). Signs the challenges: any long random
# string locally (openssl rand -base64 32). Production: 32+ characters, not this placeholder.
CAPTCHA_HMAC_KEY=dev-only-replace-me-with-32-random-bytes
# Difficulty: the phone tries up to this many PBKDF2 keys (5 000 iterations each). Default 50 (~1 s on a low-end phone).
# CAPTCHA_MAX_NUMBER=50
# SMS code login (ADR-015): off unless "true". Login is by phone or email and a password. Production refuses "true"
# until an SMS provider is wired (OQ2). Off, OTP_CONSOLE_SINK and the SMS-cost cap and its alerts are dormant.
# AUTH_SMS_ENABLED=false
# Number of proxies in front of the app, whose X-Forwarded-For entries are trusted for the per-IP rate limits.
# Required in production, even 0 (no proxy: the per-IP and per-subnet limits then don't apply, and a warning is logged).
# TRUSTED_PROXY_HOPS=1
# Instead of TRUSTED_PROXY_HOPS: a header the platform overwrites with the client's address, read as is. Vercel:
# x-vercel-forwarded-for. Only a header the client can't set itself, or one forged header picks the IP.
# CLIENT_IP_HEADER=

# --- Web push (SPEC N1) ---
# Generate a pair: node -e "console.log(require('web-push').generateVAPIDKeys())". Both keys or neither: without them
# the inbox works and push stays off. The subject is required with the keys.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid
# Bearer token for /api/push/dispatch (POST, or GET from Vercel Cron), called by the host's scheduler (T26). Unset: 404,
# so no reminders, pushes or postings catch-up (production logs a warning).
CRON_SECRET=

# Optional. An incoming-webhook URL (a Slack or Discord channel, or an email relay) that receives each ops alert as a
# JSON POST: SMS cap at 50 % / 100 %, a failed scheduler step. Event name and numbers only, no personal data. It is a
# secret: anyone holding it can post to the channel. Unset: alerts go to the server log only (src/lib/ops/alert.ts).
OPS_ALERT_WEBHOOK_URL=

# The service worker's precache revision (next.config.ts): drawn once per build (Vercel: its deployment id) and built
# in. Set it only to pin a build's revision. Build time.
# SW_REVISION=

# --- Vercel + Supabase (client demo; docs/deploy-vercel-supabase.md) ---
# Set these in Vercel → Project → Settings → Environment Variables, for Production only (previews are not used).
# They replace the local values above; a local .env never needs them. Secrets: generate each, never reuse these.
#
# Supabase (region eu-west-3, Paris; Data API off). Connection strings: Supabase → Project → Connect.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
#   transaction pooler, port 6543, for the app on Vercel; no ?sslmode (DATABASE_CA_CERT decides TLS)
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require
#   session pooler, port 5432, for `prisma migrate deploy` from your laptop only (not needed on Vercel)
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
# ...the whole supabase-ca.pem (Supabase → Project Settings → Database → SSL)...
# -----END CERTIFICATE-----"
# DATABASE_POOL_MAX=3
#
# Vercel (region cdg1, Paris: vercel.json)
# APP_ORIGIN=https://<project>.vercel.app          # or https://<your domain> once attached; no trailing slash
# CLIENT_IP_HEADER=x-vercel-forwarded-for          # replaces TRUSTED_PROXY_HOPS on Vercel
# ENABLE_EXPERIMENTAL_COREPACK=1                   # Vercel installs package.json's pnpm version
# BETTER_AUTH_SECRET=<openssl rand -base64 32>
# CAPTCHA_HMAC_KEY=<openssl rand -base64 32>
# CRON_SECRET=<openssl rand -hex 32>              # Vercel Cron sends it as "Authorization: Bearer …"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=<from web-push>     # optional, with VAPID_PRIVATE_KEY and VAPID_SUBJECT; build time
# VAPID_PRIVATE_KEY=<from web-push>
# VAPID_SUBJECT=mailto:<your address>
# OPS_ALERT_WEBHOOK_URL=<Slack/Discord webhook>   # optional
# DEMO_MODE=1                                      # the demo banner; build time: set before the first deploy
#
# Set by Vercel itself, never here: VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_DEPLOYMENT_ID (the service worker's
# revision), VERCEL_GIT_COMMIT_SHA. Leave unset on Vercel: TRUSTED_PROXY_HOPS and every test-only variable below.

# --- Client demo (ADR-016) ---
# DEMO_MODE=1 shows « Démonstration — données fictives uniquement » on every signed-in page: the demo holds synthetic
# data only. Off (unset) by default. The static pages read it at build time: set it before `next build` and rebuild
# (on Vercel, redeploy) after changing it.
# DEMO_MODE=1

# --- Test only, never in production ---
# Integration tests (*.int.test.ts) run here; the database is created and reset by the test harness. Test only.
TEST_DATABASE_URL=postgresql://poultry:poultry@localhost:5432/poultry_test
# CAPTCHA_DISABLED=true skips the captcha check (unit and int tests). Test only: production refuses to start with it.
# CAPTCHA_DISABLED=true
# OTP_CONSOLE_SINK=1 prints SMS login codes to the server log in a production build, with AUTH_SMS_ENABLED=true.
# Dormant while SMS login is off (ADR-015). Test only: production refuses to start with it, unless
# ALLOW_TEST_SERVER_IN_CI=1 and CI are both set.
# OTP_CONSOLE_SINK=1
# ALLOW_TEST_SERVER_IN_CI=1 lets the e2e production build use an http://localhost APP_ORIGIN (and OTP_CONSOLE_SINK).
# Test only: refused unless CI is set.
# ALLOW_TEST_SERVER_IN_CI=1
# STRICT_MESSAGES=1: a translation a page didn't pick throws (src/i18n/strict-messages.tsx). Test only (e2e build).
# STRICT_MESSAGES=1
# E2E_PORT: the port of the e2e server (playwright.config.ts), one per worktree. Default 3100. Test only.
# E2E_PORT=3100
# DEMO_PHONE: the owner's phone for `pnpm db:seed:demo` (prisma/demo.ts). Default +212600000099. Test only.
# DEMO_PHONE=+212600000099
# DEMO_PASSWORD: the demo owner's password (10+ characters). Unset: the seed generates one and prints it. Test only.
# DEMO_PASSWORD=
# ALLOW_DEMO_SEED=1 lets `pnpm db:seed:demo` run with NODE_ENV=production (the image sets it). Refused otherwise.
# ALLOW_DEMO_SEED=1
