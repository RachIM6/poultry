// Conventions (SPEC §6, ADR-006): UUIDv7 ids generated on the client (the DB default is only a fallback
// for server-created rows), timestamptz everywhere, and every farm-data table carries organizationId.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Owner: farm-registry
model Organization {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  createdAt   DateTime     @default(now()) @db.Timestamptz
  memberships Membership[]
}

// Owner: identity. User, Session, Account and Verification follow Better Auth's schema (ADR-005);
// ids come from the uuidv7() default (Better Auth runs with generateId: false).
model User {
  id                  String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phoneNumber         String?      @unique // E.164 +2126… / +2127…, the login identifier
  phoneNumberVerified Boolean?     @default(false)
  name                String // Better Auth requires it; set to the phone number until onboarding
  email               String       @unique // Better Auth requires it; placeholder <digits>@phone.invalid
  emailVerified       Boolean      @default(false)
  image               String?
  locale              Locale       @default(ar)
  createdAt           DateTime     @default(now()) @db.Timestamptz
  updatedAt           DateTime     @updatedAt @db.Timestamptz
  memberships         Membership[]
  sessions            Session[]
  accounts            Account[]
}

model Session {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Unused by phone login; Better Auth's adapter expects the model.
model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz
  refreshTokenExpiresAt DateTime? @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time codes: identifier = phone number, value = "<code>:<failed attempts>" (Better Auth stores it unhashed).
model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([identifier])
}

// Owner: src/lib/security/rate-limit.ts. One row per counted request (sliding window); old rows are pruned on use.
model RateLimitHit {
  id  BigInt   @id @default(autoincrement())
  key String // "<policy>:<dimension>:<window s>:<value>", phone values hashed
  at  DateTime @default(now()) @db.Timestamptz

  @@index([key, at])
}

enum Locale {
  ar
  fr
}

// Owner: identity
model Membership {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           MemberRole
  createdAt      DateTime     @default(now()) @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

enum MemberRole {
  owner
  manager
  worker
}

// Cross-cutting (ADR-006): append-only, written in the same transaction as the change. Never updated or deleted.
// No FK to Organization so the log outlives what it describes; organisation deletion purges it explicitly (ADR-007).
model AuditEvent {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId   String    @db.Uuid
  userId           String?   @db.Uuid
  entity           String
  entityId         String    @db.Uuid
  action           String
  before           Json?
  after            Json?
  mutationId       String?   @db.Uuid
  deviceCreatedAt  DateTime? @db.Timestamptz
  serverReceivedAt DateTime  @default(now()) @db.Timestamptz

  @@index([organizationId, entity, entityId])
}
